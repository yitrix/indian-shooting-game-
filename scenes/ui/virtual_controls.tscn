[node name="Instructions" type="Label" parent="HUD/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "• Left Joystick: Move character relative to camera
• Right Touch Drag: Rotate camera gimbal (Yaw & Pitch)
• Fire Button (Bottom-Right): Shoot in the camera aiming direction
• Reload button / R: Refill the magazine
• Thieves chase nearby players and attack at close range
• Defeat two thieves to reveal Neta Ji and his two armed bodyguards
• Pause button / Esc: Pause, resume, or restart
• Desktop Fallback: WASD to move, Right-click drag to look, Space / left-click to fire, R to reload"
autowrap_mode = 2

[node name="Hint" type="Label" parent="HUD/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.75, 1)
theme_override_font_sizes/font_size = 13
text = "Tap 'Controls' button again to dismiss this window."
horizontal_alignment = 1
